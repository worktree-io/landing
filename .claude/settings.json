{
  "permissions": {
    "allow": [
      "Bash(centy create issue:*)",
      "Bash(uuidgen:*)",
      "Bash(npx centy:*)",
      "Bash(pnpm dlx centy:*)",
      "Bash(centy:*)",
      "Bash(npm run build:*)",
      "Bash(gh issue list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_console_messages",
      "Bash(node --version:*)",
      "Bash(ls:*)",
      "Bash(python3 -m json.tool:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(for:*)",
      "Bash(do uuidgen)",
      "Bash(done)",
      "Bash(gh run list:*)",
      "Bash(python3:*)",
      "Bash(gh run view:*)",
      "Bash(npx playwright test --update-snapshots)",
      "Bash(gh repo view:*)",
      "Bash(command -v:*)",
      "mcp__playwright__browser_evaluate",
      "mcp__ide__getDiagnostics"
    ],
    "deny": ["Bash(gh issue create:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx block-no-verify"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx ai-fs-permissions --op read"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx ai-fs-permissions --op write"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx ai-fs-permissions --op write"
          }
        ]
      }
    ]
  }
}
